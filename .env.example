# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1

ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional overrides
CLAUDE_MODEL=claude-sonnet-5-5
GEMINI_MODEL=gemini-3.5-flash
OPENAI_MODEL=gpt-4o
AI_PROVIDER_ORDER=claude,gemini,openai
AI_TEMPERATURE=0.6
MAX_UPLOAD_MB=5
